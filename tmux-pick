#!/usr/bin/env bash
# Interactive pattern selection with fzf

set -euo pipefail

CURRENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PATTERN_SELECT="$CURRENT_DIR/bin/pattern_select"

# Cross-platform notification
notify() {
	local message="$1"
	if [[ -n "${TMUX:-}" ]]; then
		tmux display-message "$message"
	else
		echo "$message" >&2
	fi
}

# Resolve config: env var → @pick-config tmux option → bundled default (Python fallback)
if [[ -z "${PATTERN_CONFIG:-}" ]] && [[ -n "${TMUX:-}" ]]; then
	PATTERN_CONFIG=$(tmux show-option -gqv @pick-config)
fi
[[ -n "${PATTERN_CONFIG:-}" ]] && export PATTERN_CONFIG

# Check dependencies
command -v fzf &>/dev/null || {
	echo "Error: fzf not found" >&2
	exit 1
}
[[ -x "$PATTERN_SELECT" ]] || {
	echo "Error: pattern_select not found at $PATTERN_SELECT" >&2
	exit 1
}

# Capture content and pane path
if [[ -n "${TMUX:-}" ]]; then
	content=$(tmux capture-pane -p -J -S -3000)
	PANE_PATH=$(tmux display-message -p "#{pane_current_path}")
	export PANE_PATH
else
	[[ -p /dev/stdin ]] || {
		echo "Error: Must be run from tmux or with stdin" >&2
		exit 1
	}
	content=$(cat)
fi

patterns=$(printf '%s\n' "$content" | "$PATTERN_SELECT" extract) || exit 1
if [[ -z "$patterns" ]]; then
	notify "No patterns found"
	exit 0
fi

# Prepend a colored display field so fzf renders colors while keeping the
# original "value\ttype" for execution. --with-nth=1 shows only the display
# field; cut -f2- recovers the original.
display_patterns=$(printf '%s\n' "$patterns" | awk '
BEGIN {
	palette[1] = "\033[35m"; palette[2] = "\033[32m"; palette[3] = "\033[33m"
	palette[4] = "\033[36m"; palette[5] = "\033[34m"; palette[6] = "\033[31m"
	palette[7] = "\033[37m"
	next_color = 1
}
{
	n = split($0, f, "\t")
	type = f[n]
	value = $0; sub(/\t[^\t]*$/, "", value)
	if (!(type in color_map)) {
		color_map[type] = palette[next_color]
		next_color = (next_color % 7) + 1
	}
	badge = sprintf("%-7s", "[" type "]")
	printf "%s%s\033[0m %s\t%s\n", color_map[type], badge, value, $0
}')

fzf_opts=(
	--ansi
	--prompt='Select pattern: '
	--header='enter=execute  esc=cancel'
	--delimiter=$'\t'
	--with-nth=1
)
selected=$(printf '%s\n' "$display_patterns" | fzf "${fzf_opts[@]}") || exit 0

# Strip the display field; the rest is the original value\ttype
[[ -n "$selected" ]] && "$PATTERN_SELECT" execute "$(printf '%s' "$selected" | cut -f2-)"
